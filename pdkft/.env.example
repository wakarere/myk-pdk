# Copy this to .env.local and fill in your values.
# .env.local is gitignored - never commit credentials.

# ── Fivetran accounts ─────────────────────────────────────────────────────────
# Add one block per account. label must match blueprint account selection.
FIVETRAN_ACCOUNT_1_LABEL=MDS_SNOWFLAKE_HOL
FIVETRAN_ACCOUNT_1_API_KEY=your_api_key
FIVETRAN_ACCOUNT_1_API_SECRET=your_api_secret

FIVETRAN_ACCOUNT_2_LABEL=MDS_DATABRICKS_HOL
FIVETRAN_ACCOUNT_2_API_KEY=your_api_key
FIVETRAN_ACCOUNT_2_API_SECRET=your_api_secret

FIVETRAN_ACCOUNT_3_LABEL=MDS_BIGQUERY_HOL
FIVETRAN_ACCOUNT_3_API_KEY=your_api_key
FIVETRAN_ACCOUNT_3_API_SECRET=your_api_secret

# ── GCP ───────────────────────────────────────────────────────────────────────
# Uses Application Default Credentials by default (gcloud auth application-default login)
# Set GOOGLE_APPLICATION_CREDENTIALS to a service account key path to override.
GCP_PROJECT_ID=fivetran-fivetran-248-war-mraw
GCP_ZONE=us-central1-a
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# ── Snowflake (for MDS_SNOWFLAKE_HOL destination) ────────────────────────────
SNOWFLAKE_ACCOUNT=your_account.snowflakecomputing.com
SNOWFLAKE_USER=your_user
SNOWFLAKE_PAT_TOKEN=your_pat_token
SNOWFLAKE_WAREHOUSE=your_warehouse

# ── Databricks (for MDS_DATABRICKS_HOL destination) ──────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_PAT_TOKEN=your_pat_token
DATABRICKS_WAREHOUSE_ID=your_warehouse_id
DATABRICKS_CATALOG=your_catalog

# ── Demo TTL (hours before auto-teardown reminder) ───────────────────────────
DEMO_TTL_HOURS=4
